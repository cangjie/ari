    out += str.charAt(i);\n            } else if(c > 0x07FF) {\n                out += String.fromCharCode(0xE0 | ((c >> 12) & 0x0F));\n                out += String.fromCharCode(0x80 | ((c >> 6) & 0x3F));\n                out += String.fromCharCode(0x80 | ((c >> 0) & 0x3F));\n            } else {\n                out += String.fromCharCode(0xC0 | ((c >> 6) & 0x1F));\n                out += String.fromCharCode(0x80 | ((c >> 0) & 0x3F));\n            }\n        }\n        return out;\n    }\n    init();\n\n    $(\".share-wechat\").on(\"click\", function() {\n        $(\".bg-code,.qrcode\").toggle();\n    });\n    //清空二维码\n    $(\".close-btn\").on(\"click\", function(event) {\n        $(\".bg-code,.qrcode,.close-btn\").hide();\n        event.stopPropagation();\n    });\n\n    function showToQzone() {\n         var _desc = description;\n         var _title = title;\n         var _url = portalUrl;\n         var _shareUrl = 'http://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?';\n         _shareUrl += 'url=' + encodeURIComponent(_url);   //参数url设置分享的内容链接|默认当前页location\n         _shareUrl += '&title=' + encodeURIComponent(_title);    //参数title设置分享标题，可选参数\n         window.open(_shareUrl,'','width=700,height=680,top=0,left=0,toolbar=no,menubar=no,scrollbars=no,resizable=1,location=yes,status=0'); \n    }\n\n    function showToSina(title, portalUrl, desc) {\n        var _desc = desc;\n        var _t = title + \" \" + _desc;\n        var _url = portalUrl;\n        var _appkey = \"2806082167\"; //你从微薄获得的appkey\n        var _site = ''; //你的网站地址\n        var _ralateUid = \"\";\n        var _u = 'http://service.weibo.com/share/share.php?url=' + _url + '&appkey=' + _appkey + '&title=' + _t + '&ralateUid=' + _ralateUid + '&searchPic=false';\n        window.open(_u, '', 'width=700, height=680, top=0, left=0, toolbar=no, menubar=no, scrollbars=no, location=yes, resizable=no, status=no');\n    }\n    \n    $('.share-qqzone').on('click', function() {\n        showToQzone(title, portalUrl, description);\n    });\n    $('.share-weibo').on('click', function() {\n        showToSina(title, portalUrl, description);\n    });\n});\n    </script>\n    <!--分享代码e-->\n                </div>\n                <dl class=\"fr\" id=\"fontSize\">\n                    <script language='JavaScript' type=\"text/javascript\">\n                        function changeSize(size) {\n                            document.getElementById('mainText').style.fontSize=size+'px'\n                        }\n                    </script>\n                    字号：&nbsp;&nbsp;\n                    <a href='javascript:changeSize(18)' >大</a>&nbsp;&nbsp;\n                    <a href='javascript:changeSize(16)' class=\"on\">中</a>&nbsp;&nbsp;\n                    <a href='javascript:changeSize(14)' >小</a>\n                </dl>\n            </div>\n            <div class=\"repeatX\"></div>\n        </div>\n    </div>\n    <!--头部-e-->\n\n<div class=\"main_container\">\n    <!--正文-s-->\n<div class=\"left_part\">\n    <div class=\"mainTextBox\">\n        <div id=\"mainText\">\n            <!-- 自定义封面图 -->\n            <div id=\"posterWrap\" style=\"display:none;\">\n                <div><img src=\"./W020260910390746154337.jpg\" border=0/>辛苦了老师 教师节这天 什刹海给老师留了一份秋色</div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n                <div></div>\n            </div>\n            <!-- 播放器 -->\n            <div class=\"m-player-box\">\n                <video id=\"my-video\" class=\"video-js vjs-big-play-centered\" webkit-playsinline=\"true\" playsinline=\"true\"></video>\n                <div id=\"MultiAttachPh\" style=\"display:none;\"></div>\n            </div>\n            <!-- 播放器 -->\n            <div id=\"pic\">\n                <ul id=\"pic_0\">\n                    <li><img src=\"./W020260910390746154337.jpg\" border=\"0\" alt=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" title=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" /></li>\n                    <li>辛苦了老师 教师节这天 什刹海给老师留了一份秋色</li>\n                </ul>\n                <ul id=\"pic_1\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_2\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_3\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_4\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_5\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_6\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_7\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_8\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n                <ul id=\"pic_9\">\n                    <li><img src=\"\" border=\"0\" alt=\"\" title=\"\" /></li>\n                    <li></li>\n                </ul>\n            </div>\n            <div class=\"view TRS_UEDITOR trs_paper_default trs_web\"><p>　　三尺讲台，四季耕耘。老师的辛苦，往往藏在那些不起眼的日常里，批改作业到深夜的台灯，反复讲解同一道题的耐心，还有那些年我们不听话时，他们恨铁不成钢的眼神。</p><p>　　这个教师节，什刹海周边已经备好了一份实实在在的放松路线推荐。拿着教师资格证，带上好心情，来一场专属节日的秋日漫游吧。</p><p style=\"text-align: center\"><img src=\"./W020260910390744744804.jpg\" width=\"700\" height=\"449\" title=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" alt=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" style=\"width: 700px; height: 449px;\" OLDSRC=\"W020260910390744744804.jpg\" /></p><p>　　<strong>9:00 -11:00宋庆龄故居</strong></p><p>　　教师节当天持教师资格证，免费参观。这座始建于清康熙年间的庭院，曾是大学士明珠的府邸花园，后为末代皇帝溥仪之父醇亲王载沣的府邸花园。1963年至1981年，宋庆龄在此工作生活了18年，故居保留了宋庆龄生前工作、生活的原貌，书房里她批阅过的文件、卧室里她用过的藤椅、院子里她亲手栽种的花木，都静静地讲述着这位伟大女性的故事。秋日漫步园中，古树参天，湖水环绕，最适合静下心来慢慢逛。</p><p style=\"text-align: center\"><img src=\"./W020260910390744832109.jpg\" width=\"700\" height=\"393\" title=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" alt=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" style=\"width: 700px; height: 393px;\" OLDSRC=\"W020260910390744832109.jpg\" /></p><p>　　<strong>12:00 后海边的“贴秋膘”</strong></p><p>　　参观完宋庆龄故居，沿着后海北沿向东走，午饭可以选择银锭桥畔的烤肉季，烤肉季的羊肉只选用内蒙古苏尼特羊的“上脑”和“后腿”两个部位，片成2毫米厚的薄片，用刀背捶打至半透明，加入秘制料汁和葱丝、香菜腌制，再放到炙子上烤熟；也可以选京城“八大楼”中最早的一栋庆云楼，可以边吃边看前海景色；还有常年霸榜必吃榜，坚持传统的炭火铜锅、清汤涮肉的鸦儿李记，各种美食等您来品尝。</p><p style=\"text-align: center\"><img src=\"./W020260910390744929761.jpg\" width=\"700\" height=\"466\" title=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" alt=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" style=\"width: 700px; height: 466px;\" OLDSRC=\"W020260910390744929761.jpg\" /></p><p>　　<strong>14:00 后海漫步+文创打卡</strong></p><p>　　吃完午饭，沿后海石栏往东散步。秋天的后海，天高云淡，水面上波光粼粼。看“银锭观山”是老北京著名的景色，沿着湖边，逛到荷花市场，到顺时而饮喝杯下午茶，在什刹海文创店选个小礼物作为纪念，最后去金锭桥看看夕阳，看什刹海的日落，水天一色，落日熔金，为这趟半日游画上完美的句号。</p><p style=\"text-align: center\"><img src=\"./W020260910390745030841.jpg\" width=\"521\" height=\"391\" title=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" alt=\"辛苦了老师 教师节这天 什刹海给老师留了一份秋色\" style=\"width: 521px; height: 391px;\" OLDSRC=\"W020260910390745030841.jpg\" /></p><p>　　教师节只有一天，但老师值得被感谢每一天，这趟行程虽然简单，但从宋庆龄故居的百年古树，到银锭桥畔的炙子烤肉，再到荷花市场的秋日夕阳，希望老师们能在忙碌之余，抽出半天时间，来什刹海走一走，学生时代的回忆，或许就在某条胡同转角处。</p><p>　　在此，祝老师们节日快乐！</p></div>\n            <div id=\"filerider\">\n                <div class=\"filelink\" style=\"margin:10px 0 0 0;\">\n                    \n                    <!---->\n                </div>\n            </div>\n        </div>\n        \n    </div>\n<!