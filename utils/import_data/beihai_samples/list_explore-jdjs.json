{"success":true,"message":"操作成功！","code":200,"result":{"records":[{"id":"e19c2fef4cca4b41895e7c89d17c3cdf","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"漪澜堂  Yi Lan Tang","fdPicture":"temp/漪澜堂_1761621759227.png,temp/15-09-030209-246656866_1761621919844.png,temp/15-09-4807512070262412_1761621923510.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:26:53","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"北海漪澜堂景区坐落于北海公园琼华岛北侧，占地总面积1.2公顷，陆地面积1公顷，总建筑面积为 3900余平方米，包括漪澜堂、道宁斋、晴栏花韵等古建筑以及迭石、古树名木和水系等附属文物。漪澜堂景区肇建于乾隆十六年（公元1751年），是皇家游憩、宴饮及文化生活的场所。"},{"id":"2caa452e24d44f1b9edbe5d8d4b7e207","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"静心斋 Jing Xin Zhai","fdPicture":"temp/静心斋_1761621979712.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:27:59","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"静心斋原名镜清斋，始建于清乾隆二十一年（1756年），乾隆二十三年（1758年）竣工，占地面积9308平方米。"},{"id":"57ec180c97c844fba0ebbd17de5cacdf","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"琼岛春阴碑  Qiongdao spring Yin monument","fdPicture":"temp/琼岛春阴碑_1761622393223.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:28:14","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"“琼岛春阴”为金代“燕京八景”之一。"},{"id":"9C8802BA1A4249818ED0A95DDA5653FD","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"遮荫候  Shading","fdPicture":"temp/遮荫候_1761622048733.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 11:17:09","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"生长在承光殿左侧，是一株10多米高、枝叶茂盛的油松，其姿态苍劲挺拔，如伞盖遮天。相传“遮荫侯”爵位为乾隆皇帝亲封。"},{"id":"a1a20493b83b4ff28793958fdd8aa39f","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"玉瓮  Jade urn","fdPicture":"temp/玉瓮_1761622108146.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-10-28 11:28:31","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"玉瓮又称“渎山大玉海”，制作于至元二年（1265年）。"},{"id":"0a5cc638e98f4f93834b69aaf9160234","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"白袍将军  White robe general","fdPicture":"temp/白袍将军_1761622163808.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:17:34","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"此树为白皮松，相传植于金代。清乾隆皇帝曾封此树为“白袍将军”。白皮松为华北珍贵的观赏树。"},{"id":"e7e394a842ae498ab7884c2aaa08abde","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"承光殿  Chengguang Temple","fdPicture":"temp/承光殿_1761622007383.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:28:42","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"a5a1a9ebfd9c4a1a8c4f0c28068e70a3","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"团城  Mission City","fdPicture":"temp/团城_1761622271652.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-10-28 11:31:16","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"团城原是太液池中的一个小岛，金代为大宁宫一部分。元代称圆坻，亦称瀛洲。"},{"id":"d382dab53c1442f49c5299e2f03442ff","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"阅古楼  unknow","fdPicture":"temp/IMGL0933(1)_1763559381217.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 11:41:19","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"阅古楼，清乾隆十八年（1753年）为保存《三希堂法帖》石刻而建，平面作半月形，上下两层，延楼二十五楹，左右围抱。"},{"id":"e61f3858b4654c42948bee513d1f733f","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"永安寺  Yongan Temple","fdPicture":"temp/永安寺_1761622435091.png,temp/微信图片_20251119204341_64_123(1)_1763556899778.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-19 20:56:34","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"永安寺位于北海白塔山南麓。始建于清顺治八年（1651年）。"},{"id":"4d8a6c27a86d4746948af8b1f85e18e8","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"先蚕坛  First silkworm altar","fdPicture":"temp/先蚕坛_1761622479257.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 11:44:20","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"先蚕坛是北京九坛之一，是现存较完整的一处皇室祭祀“蚕神”的地方。"},{"id":"d9d392e933884262bff657fca64602a6","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"画舫斋  Painting zhai fasting","fdPicture":"temp/画舫斋_1761622536375.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:13:14","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"建于清乾隆二十二年（公元1757年），原据欧阳修的《画舫斋记》而造其形、得其名。"},{"id":"1eec059c1d0d46d5848c836684de754f","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"濠濮间  Ho Pu between","fdPicture":"temp/濠濮间_1761629643846.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:09:38","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"濠濮间位于北海东岸的画舫斋和春雨林塘之南，与画舫斋和春雨林塘同期建成，殿宇和游廊均为灰筒瓦屋面。占地面积4416平方米，建筑面积350.12平方米。\n"},{"id":"e5a54b29853949c8b919f2eb2a29337a","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"五龙亭  Wulong Ting","fdPicture":"temp/五龙亭_1761629690760.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 11:46:56","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"五龙亭位于北海太液池西北隅，建于明嘉靖朝（1522-1566年），中为龙泽亭，左为涌瑞亭、浮翠亭；右为澄祥亭、滋香亭。\n"},{"id":"3d515bb55280465c9bf0b6bb0f6bbb5b","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"西天梵境  West Vatican","fdPicture":"temp/西天梵境_1761629726351.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:06:47","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"“西天梵境”又称大西天，东临静心斋，西与大圆境智宝殿相依，南与琼华岛贯成一线，是北海最负盛名的景区之一。"},{"id":"88c99c368b504ecc9835a745fd168d25","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"快雪堂书法博物馆  Quick snow hall","fdPicture":"temp/快雪堂书法博物馆_1761629791932.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-10-28 13:36:41","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"快雪堂为三进院落，分别为澄观堂、浴兰轩、快雪堂，院内四周由彩绘游廊连接。其中，澄观堂、浴兰轩建于清乾隆十一年（1746年），是皇帝的行宫。乾隆四十四年（1779年），乾隆皇帝为收藏48方书法石刻，特增建快雪堂院落， 1923年，为纪念讨袁护国运动的著名将领蔡锷（字松坡）将军，经黎元洪批准，将快雪堂三进院落拨作“松坡图书馆”第一馆，梁启超出任馆长，第一馆专藏中文书籍（石虎胡同成立第二馆藏外文书籍）。\n"},{"id":"0f640d0a13234781be93c9aa2797852a","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"九龙壁  Kowloon wall","fdPicture":"temp/九龙壁_1761629833956.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:01:21","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"九龙壁是原大圆镜智宝殿前的影壁，建于乾隆二十一年（1756年）。壁高5.96米，厚1.60米，长25.52米。壁的两面用七色琉璃砖瓦镶砌而成。\n"},{"id":"845f0705cde44c51a0afe1fd2d2f5566","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"铜仙承露盘  Tongxian exposed plate","fdPicture":"temp/铜仙承露盘_1761622313766.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:12:21","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"铜仙承露盘是清乾隆皇帝仿汉武帝故事而建。于石座上竖汉白玉蟠龙柱，柱顶端立一双手托盘的铜人，通高6.6米。"},{"id":"51faaa2e109843ef86d85ea8e47ecd5d","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"铁影壁  Iron wall","fdPicture":"temp/铁影壁_1761629870242.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:14:27","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"元代遗物，壁呈棕褐色，由中性火山块砾岩雕成，因颜色和质地似铁，故称铁影壁。\n"},{"id":"26b8aa802284431c82905aed52581a75","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"小西天  Little West","fdPicture":"temp/小西天_1761629907793.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:13:50","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"小西天始建于清乾隆三十三年（公元1768 年），建成于清乾隆三十五年（公元1770 年），是清乾隆皇帝为母亲孝圣皇太后祝寿祈福而建的\n\n\n"},{"id":"8d8a18c6964743309fd6688a83af3a04","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"智珠殿  Pearl house","fdPicture":"temp/智珠殿_1761622218147.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:22:42","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"智珠殿，半月城位于琼岛东麓山脚下，坐西面东与陟山桥相对，建于乾隆十六年（1751年）。\n"}],"total":21,"size":50,"current":1,"pages":1},"timestamp":1791459023273}