,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-13 15:49:43","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"1161dd35d69a47008a0808d8960e8351","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/GA99AjMYraZojAcVY5kuvA","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"北海公园文化研学招募","fdPicture":"temp/ScreenShot_2025-11-26_165101_963_1764147078525.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":null,"fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:51:47","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"穿越百年戏楼，探秘皇家听戏时的饮食文化；亲手制作宫廷糕点，品味鲜牛奶带来的匠心传承。这个周末，让我们探寻北海公园画舫斋，开启一场融合建筑声学、宫廷饮食文化和乳品科学的独特的研学之旅。"},{"id":"79bcae367628479784b5d9e2bf2b48e0","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"f949dcc802b84bd7b429707bd8a3552a","fdTitle":"万佛楼遗址-硫华菊","fdPicture":"temp/LIU00351_1763693833872.JPG","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":null,"fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-21 10:57:19","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"17a5cff78b4445cab3afced36dca9e12","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/Lg_D9WqSjIhTqhAsTYrhvA","fdColumnId":"12f51ff09679485e91dd3502389154d1","fdTitle":"科普北海|古代戏楼里的声学探秘","fdPicture":"temp/戏楼_1763569964368.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":null,"fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 00:32:55","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"在雕梁画栋的皇家园林深处，隐藏着惊人的声学智慧。这个秋天，让我们一同走进北海公园画舫斋和漪澜堂，近距离感受清代戏台中的声学现象，用科学的钥匙打开声学密码，开启一场别开生面的声学探索之旅。"},{"id":"06bbbc500ebc420aaa2dcd3b3de271b1","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/Y5fCyYWGW1JgPNbAruY7Eg","fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"白塔之约·北海研学‖“北海菊韵”传统插花文化体验，邂逅千年风雅与当代新意","fdPicture":"temp/研学1_1763568979894.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:45:56","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"特别推出“北海菊韵”传统插花雅集，将北海的菊文化引入案头清供，让您在亲手插作中感受“四君子”的高洁风骨，体验从园林到室内的东方美学传承！"}],"total":56,"size":50,"current":1,"pages":2},"timestamp":1791459021713}