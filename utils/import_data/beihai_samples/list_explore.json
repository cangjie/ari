dSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 11:46:56","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"五龙亭位于北海太液池西北隅，建于明嘉靖朝（1522-1566年），中为龙泽亭，左为涌瑞亭、浮翠亭；右为澄祥亭、滋香亭。\n"},{"id":"3d515bb55280465c9bf0b6bb0f6bbb5b","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"西天梵境  West Vatican","fdPicture":"temp/西天梵境_1761629726351.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:06:47","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"“西天梵境”又称大西天，东临静心斋，西与大圆境智宝殿相依，南与琼华岛贯成一线，是北海最负盛名的景区之一。"},{"id":"88c99c368b504ecc9835a745fd168d25","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"快雪堂书法博物馆  Quick snow hall","fdPicture":"temp/快雪堂书法博物馆_1761629791932.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-10-28 13:36:41","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"快雪堂为三进院落，分别为澄观堂、浴兰轩、快雪堂，院内四周由彩绘游廊连接。其中，澄观堂、浴兰轩建于清乾隆十一年（1746年），是皇帝的行宫。乾隆四十四年（1779年），乾隆皇帝为收藏48方书法石刻，特增建快雪堂院落， 1923年，为纪念讨袁护国运动的著名将领蔡锷（字松坡）将军，经黎元洪批准，将快雪堂三进院落拨作“松坡图书馆”第一馆，梁启超出任馆长，第一馆专藏中文书籍（石虎胡同成立第二馆藏外文书籍）。\n"},{"id":"0f640d0a13234781be93c9aa2797852a","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"九龙壁  Kowloon wall","fdPicture":"temp/九龙壁_1761629833956.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:01:21","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"九龙壁是原大圆镜智宝殿前的影壁，建于乾隆二十一年（1756年）。壁高5.96米，厚1.60米，长25.52米。壁的两面用七色琉璃砖瓦镶砌而成。\n"},{"id":"845f0705cde44c51a0afe1fd2d2f5566","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"铜仙承露盘  Tongxian exposed plate","fdPicture":"temp/铜仙承露盘_1761622313766.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:12:21","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"铜仙承露盘是清乾隆皇帝仿汉武帝故事而建。于石座上竖汉白玉蟠龙柱，柱顶端立一双手托盘的铜人，通高6.6米。"},{"id":"51faaa2e109843ef86d85ea8e47ecd5d","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"铁影壁  Iron wall","fdPicture":"temp/铁影壁_1761629870242.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:14:27","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"元代遗物，壁呈棕褐色，由中性火山块砾岩雕成，因颜色和质地似铁，故称铁影壁。\n"},{"id":"26b8aa802284431c82905aed52581a75","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"小西天  Little West","fdPicture":"temp/小西天_1761629907793.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:13:50","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"小西天始建于清乾隆三十三年（公元1768 年），建成于清乾隆三十五年（公元1770 年），是清乾隆皇帝为母亲孝圣皇太后祝寿祈福而建的\n\n\n"},{"id":"8d8a18c6964743309fd6688a83af3a04","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"5e2445348bd448f08d7fd9835aec5df8","fdTitle":"智珠殿  Pearl house","fdPicture":"temp/智珠殿_1761622218147.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 12:22:42","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"智珠殿，半月城位于琼岛东麓山脚下，坐西面东与陟山桥相对，建于乾隆十六年（1751年）。\n"},{"id":"48f8c3362fcb475e8605905931f21e3b","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/pkRPxgY5Mq8f_StT1lf0fw","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"白塔之约·北海研学：“漪澜雅趣·古风竞春会”活动招募","fdPict