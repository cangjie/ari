:47","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"穿越百年戏楼，探秘皇家听戏时的饮食文化；亲手制作宫廷糕点，品味鲜牛奶带来的匠心传承。这个周末，让我们探寻北海公园画舫斋，开启一场融合建筑声学、宫廷饮食文化和乳品科学的独特的研学之旅。"},{"id":"17a5cff78b4445cab3afced36dca9e12","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/Lg_D9WqSjIhTqhAsTYrhvA","fdColumnId":"12f51ff09679485e91dd3502389154d1","fdTitle":"科普北海|古代戏楼里的声学探秘","fdPicture":"temp/戏楼_1763569964368.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":null,"fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 00:32:55","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"在雕梁画栋的皇家园林深处，隐藏着惊人的声学智慧。这个秋天，让我们一同走进北海公园画舫斋和漪澜堂，近距离感受清代戏台中的声学现象，用科学的钥匙打开声学密码，开启一场别开生面的声学探索之旅。"},{"id":"06bbbc500ebc420aaa2dcd3b3de271b1","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/Y5fCyYWGW1JgPNbAruY7Eg","fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"白塔之约·北海研学‖“北海菊韵”传统插花文化体验，邂逅千年风雅与当代新意","fdPicture":"temp/研学1_1763568979894.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:45:56","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"特别推出“北海菊韵”传统插花雅集，将北海的菊文化引入案头清供，让您在亲手插作中感受“四君子”的高洁风骨，体验从园林到室内的东方美学传承！"},{"id":"36174444292e417fb8a2bf8546804654","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/8NsnOpt86Kj4CHBL4f1-3A","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"白塔之约-北海公园文化研学招募（琼岛篇）","fdPicture":"temp/白塔侧面_1763614774106.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:47:08","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"推开历史之门，做一日皇家园林探索者！"},{"id":"be74d1b3e1eb4085814376dd3764df9d","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/HJOHr4fDfawf65rnvpPIaQ","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"白塔之约·北海研学树叶画回顾","fdPicture":"temp/640_1763563524918.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":null,"fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-19 22:45:45","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"亲子共探自然密码\n树叶画里藏童真"},{"id":"af2e6f173fa9438dbbfa63572bf1f484","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/WPQnMSr_z35JhDwuq8cDug","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"白塔之约·北海研学‖闯入北海秋日童话！认树木·解变色密码·做专属秋叶画","fdPicture":"temp/微信图片_20251119175831_1763546318553.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-20 00:18:26","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"fcb2d6ab046d457b9273121656b09031","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/JWXSwMwPfZsPGRmfpvZ8Pg","fdColumnId":"4c5391c4e0974e10a2c9ce488a867c71","fdTitle":"北海公园文化研学招募","fdPicture":"temp/微信图片_20251119175409_1763546056761.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:46:59","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"b7976d3d3dd544f5abb3c5c2f5045156","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"荷花","fdPicture":"temp/14-35-170923-2056393848_1757499406700.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"admin","fdPublishTime":"2025-09-10 23:51:20","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"据史书记载：远在辽代的时候，北海这一带曾是一片湖泊沼泽，芦荻丛生的地方。金代开竣湖泊，逐渐形成为一个风景区，称为“白莲潭”。白莲潭中广植莲花，池中养有鱼鸟，晨曦射波，池光映天，绿荷含香，鱼鸟中游，又有莲舟夹持在中间，却是一幅极美的画面。由此可见，北海在池中种植荷花的历史是从金代就开始了。金人赵炳文在《扈跸万宁宫》中形容：“一声清跸九开天，白日雷霆引仗来：花尊夹城通禁御，曲江两岸尽楼台。柳荫日迎雕辇，荷花分香入酒杯：遥想薰风临水殿，五弦声里阜民财。”描写了当时太宁宫的园林胜景，同时从此诗中我们也能感到池中盛开荷花的芬芳美艳。"},{"id":"E7BB1E676A3942AFB356ECAF34942C7E","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/ZXhWHEV4Hbrqbg7jv7cGRg","fdColumnId":"12f51ff09679485e91dd3502389154d1","fdTitle":"白塔之约·“雅菊逸趣”活动回顾：一场菊花文化与自然的深度对话","fdPicture":"temp/微信图片_20251119175037_1763545856056.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2025-11-26 16:52:33","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null}],"total":24,"size":50,"current":1,"pages":1},"timestamp":1791459029578}