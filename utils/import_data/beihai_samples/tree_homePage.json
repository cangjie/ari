:"b91a543a5c3c48488c8cf7e86d0b4700","fdExternalLinksUrl":null,"pid":"8589478f692e4184901c0f775bc3aee8","fdColumnName":"科普知识","fdIsExternalLinks":"N","fdRemarks":null,"hasChild":"0","fdPicture":null,"fdUser":null,"fdBrowserType":null,"fdUploadType":"3","fdColumnHeadingStyle":null,"fdShowArticleTitle":"0","fdExtendInfo":null,"fdBannerPic":"temp/explore-background-banner_1756112187570.png,temp/explore-background-banner_1756202500845.png","fdInfoColumn":"1","articleList":[{"id":"cee9e22cfb494e179dfbc132bc0f663c","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"北海荷花","fdPicture":"temp/ScreenShot_2025-11-20_160332_956(1)_1763625943314.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-09-02 17:55:00","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"A14DBBE97BE249EAB0574DBC1CEABA84","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"团城古树与园林智慧的对话","fdPicture":"temp/雪中承光殿-副本(1)_1763563068327.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:50:00","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"b945f353d74a48b9bee631a6dd664d8f","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"团城古树系列——大自然传粉的奇妙智慧","fdPicture":"temp/14-38-480864-1308781420_1757499115921.jpeg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:50:02","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":null},{"id":"57f6f6c61f6748e49973a2864e324344","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/ALOAG93gZzXGRFD8a8zMMg","fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"科普北海丨品味标本菊的审美之道","fdPicture":"temp/微信图片_20251105095221_1762307549984.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"2","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:47:38","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"深秋时节，百花渐寂，唯菊花傲霜绽放，标本菊以一株一花的独特魅力成为古今鉴赏家的心头之好。养护标本菊需在其生长过程中不断摘除侧枝侧蕾，将全部营养供给中心花蕾，使花朵充分展现该品种的最佳状态。一朵精心培育的标本菊，直径可达30-40厘米，花瓣数量可达数百片，其形态之完美，色彩之纯粹，展现着菊花栽培的最高技艺。"},{"id":"06bbbc500ebc420aaa2dcd3b3de271b1","fdIsExternalLinks":"2","fdExternalLinksUrl":"https://mp.weixin.qq.com/s/Y5fCyYWGW1JgPNbAruY7Eg","fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"白塔之约·北海研学‖“北海菊韵”传统插花文化体验，邂逅千年风雅与当代新意","fdPicture":"temp/研学1_1763568979894.jpg","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"bhadmin","fdPublishTime":"2026-01-07 14:45:56","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"特别推出“北海菊韵”传统插花雅集，将北海的菊文化引入案头清供，让您在亲手插作中感受“四君子”的高洁风骨，体验从园林到室内的东方美学传承！"},{"id":"b7976d3d3dd544f5abb3c5c2f5045156","fdIsExternalLinks":"1","fdExternalLinksUrl":null,"fdColumnId":"8d236ef4bd0e4cb1adb92a23132a725e","fdTitle":"荷花","fdPicture":"temp/14-35-170923-2056393848_1757499406700.png","fdSubTitle":null,"fdSubTitleTwo":null,"fdAnnex":null,"fdTopping":"1","fdPublishingUnit":null,"fdPublisher":"admin","fdPublishTime":"2025-09-10 23:51:20","fdUpPicture":null,"fdTitleTwo":null,"fdSynopsis":"据史书记载：远在辽代的时候，北海这一带曾是一片湖泊沼泽，芦荻丛生的地方。金代开竣湖泊，逐渐形成为一个风景区，称为“白莲潭”。白莲潭中广植莲花，池中养有鱼鸟，晨曦射波，池光映天，绿荷含香，鱼鸟中游，又有莲舟夹持在中间，却是一幅极美的画面。由此可见，北海在池中种植荷花的历史是从金代就开始了。金人赵炳文在《扈跸万宁宫》中形容：“一声清跸九开天，白日雷霆引仗来：花尊夹城通禁御，曲江两岸尽楼台。柳荫日迎雕辇，荷花分香入酒杯：遥想薰风临水殿，五弦声里阜民财。”描写了当时太宁宫的园林胜景，同时从此诗中我们也能感到池中盛开荷花的芬芳美艳。"}],"children":[]}},"siteSetting":{"id":"b91a543a5c3c48488c8cf7e86d0b4700","createBy":"admin","updateDate":null,"tenantId":"0","updateBy":"admin","delFlag":0,"createDate":"2025-08-08 00:00:00","fdBackgroundImg":null,"fdFlowdesc":null,"fdTheme":"0","fdTopImg":null,"fdFlowstatus":null,"fdLogoImg":"temp/logo2_1756259834278.png","fdRemarks":"1","f