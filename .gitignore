# IDE（含机器本地绝对路径，不跨机器同步）
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 环境与密钥
.env
.env.*

# 证书与私钥 —— 绝不进仓库
*.zip
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx

# macOS
.DS_Store

# ────────────────────────────────────────────────────────────
# 切勿忽略以下目录 —— 它们装着 start-work / end-work 在各 AI 工具
# 下的命令入口。一旦被忽略，换台电脑 clone 下来命令会静默消失：
#   .claude/   .agents/   .github/
# ────────────────────────────────────────────────────────────

# 导出的 Excel 是派生文件，可由 export_excel.py 随时从库里重新生成，不入仓库
# 两个拼写都要挡：export_excel.py 写 exports/，merge_mfa_xlsx.py 写 export/。
# 2026-09-14 发现只挡了复数那个，export/ 里的 4MB xlsx 一直是未跟踪且未忽略。
utils/import_data/exports/
utils/import_data/export/

# tier_v3.py 的评分中间结果与审阅表。JSONL 是断点续跑用的缓存，CSV 由它生成。
# 都是派生文件，且重跑要花 API 额度，本地留着即可，不入仓库。
utils/import_data/tier_v3_out/

# 评分与审计的产出：**JSONL 与审阅 CSV 要入仓库**，日志与一次性驱动脚本不要。
# 与上面的 tier_v3_out 相反 —— 那批评分只存在于数据库里、脚本复现不出来，
# 2026-08-31 就因此不敢重建 artwork_evidence，只能 ALTER。审计重跑一次要
# 2.5 小时 API，几 MB 换「随时可复核、可重灌」，值。
utils/import_data/**/*.log
utils/import_data/**/run_*.sh

# 已被推翻的中间轮次。都是在有缺陷的提示词下跑出来的（详见该目录的 README），
# 本地留着可回溯，但**不能入仓库** —— 混在权威结果旁边只会被当成结论读。
utils/import_data/_superseded/

# 本地临时虚拟环境（服务器用 /opt/ari/.venv，与此无关）
.venv_local/

# 外部抓取的缓存（Wikidata SPARQL 结果等）。派生文件，且 WDQS 会限流，
# 本地留一份复用即可；要更新用 meta_scrape_pem.py --refresh-wikidata
utils/import_data/meta_cache/

# 伪满皇宫官网的原始响应缓存（wmhg_site_scrape.py）。只为重跑时不再打扰官网。
# 挑出来的样本在 wmhg_samples/，**那个要入仓库** —— 写解析器的机器连不上官网（境外出口）
utils/import_data/wmhg_raw/
# 吉林省博物院同理（jlpm_site_scrape.py），样本在 jlpm_samples/，入仓库
utils/import_data/jlpm_raw/

# 去重的中间产物：零 API、几秒可重生成（dedupe_recall.py / dedupe_group.py --dry-run），
# 且 dedupe_groups.json 每次空跑都被覆盖，与实际跑过的 dedupe_clusters.json 的组号对不上。
# 花过钱或联网抓来的（dedupe_facts.json、dedupe_llm_cache.jsonl、dedupe_clusters.json）照常入库。
utils/import_data/dedupe_cands.json
utils/import_data/dedupe_groups.json
